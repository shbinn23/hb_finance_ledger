# DB
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ledger
DB_USER=admin
DB_PASSWORD=admin

# 후잉 API
WHOOING_APP_ID=
WHOOING_TOKEN=
WHOOING_SIGNATURE=
WHOOING_SECTION_ID=

# 대시보드 (dashboard/.env.local)
# GITHUB_TOKEN=
# GITHUB_OWNER=
# GITHUB_REPO=
# GITHUB_WORKFLOW_ID=sync.yml

# Host에서 dashboard를 직접 실행할 때만 사용
# Docker Compose dashboard는 docker-compose.yml에서 http://ml-engine:8000를 고정 주입
ML_ENGINE_URL=http://127.0.0.1:8000
ML_ENGINE_TIMEOUT_MS=60000
ETL_SERVICE_URL=http://127.0.0.1:8080
ETL_SYNC_TIMEOUT_MS=15000
# Gmail read-only import (keep disabled until personal OAuth consent is complete)
GMAIL_IMPORT_ENABLED=false
GMAIL_IMPORT_DRY_RUN_ONLY=true
GMAIL_IMPORT_LABEL=
GMAIL_IMPORT_QUERY=has:attachment filename:xlsx subject:(편한가계부 OR 가계부)
GMAIL_IMPORT_POLL_INTERVAL_MS=300000
GMAIL_CREDENTIALS_FILE=
GMAIL_TOKEN_FILE=
# Equivalent explicit path names supported by the runtime.
GMAIL_OAUTH_CREDENTIAL_PATH=
GMAIL_TOKEN_PATH=
GMAIL_API_TIMEOUT_MS=15000
# Alternative OAuth values; never commit real values.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
ML_ENGINE_PORT=8000
DASHBOARD_PORT=3000
MONTHLY_SPEND_LIMIT=2100000
