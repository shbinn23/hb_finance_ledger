# DB
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ledger
DB_USER=admin
DB_PASSWORD=admin

# 후잉 API
WHOOING_APP_ID=
WHOOING_TOKEN=
WHOOING_SIGNATURE=
WHOOING_SECTION_ID=

# 대시보드 (dashboard/.env.local)
# GITHUB_TOKEN=
# GITHUB_OWNER=
# GITHUB_REPO=
# GITHUB_WORKFLOW_ID=sync.yml

# Host에서 dashboard를 직접 실행할 때만 사용
# Docker Compose dashboard는 docker-compose.yml에서 http://ml-engine:8000를 고정 주입
ML_ENGINE_URL=http://127.0.0.1:8000
ML_ENGINE_TIMEOUT_MS=60000
ML_ENGINE_PORT=8000
DASHBOARD_PORT=3000
MONTHLY_SPEND_LIMIT=2100000

SLACK_BOT_TOKEN=your_slack_bot_token
SLACK_SIGNING_SECRET=your_slack_signing_secret
